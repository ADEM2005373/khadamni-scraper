# Database Connection (PostgreSQL - Prisma / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/khadamni_scraper?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/khadamni_scraper?schema=public"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-random-key-change-in-production-min-32-chars"

# Google Gemini API (CV Parsing, ATS Scoring & Success Prediction)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Supabase Storage Configuration (PDF CV Uploads)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_CV_BUCKET="cv-uploads"

# Playwright & Scraping Engine Settings
SCRAPER_HEADLESS="true"
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
